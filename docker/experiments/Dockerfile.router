# Env-tunable router confidence thresholds on top of turboocr:pool.
# Patches only router_types.h and cua_router.cpp; all other binaries
# are reused as-is from the pool image.
# Nginx listens on 8082 (instead of 8000) so this can coexist with pool on host network.
FROM turboocr:pool AS builder

USER root

COPY docker/experiments/router_patch/router_types.h /app/include/turbo_ocr/router/router_types.h
COPY docker/experiments/router_patch/cua_router.cpp /app/src/router/cua_router.cpp

RUN cd /app/build && \
    cmake .. -DTENSORRT_DIR=/usr/lib/x86_64-linux-gnu -DFETCH_MODELS=OFF && \
    make -j$(nproc) turboocr-server 2>&1

FROM turboocr:pool
USER root
COPY --from=builder /app/build/turboocr-server /app/build/turboocr-server
COPY docker/experiments/router_patch/nginx.conf.template /app/docker/nginx.conf.template
RUN chown ocr:ocr /app/build/turboocr-server

ENTRYPOINT ["/app/scripts/entrypoint.sh"]
CMD ["./build/turboocr-server"]
