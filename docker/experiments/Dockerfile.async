# Incremental rebuild on top of turboocr:pool — async VLM dispatch.
# GPU pipeline workers submit VLM crops and return immediately; HTTP
# workers block on futures. Env: ASYNC_VLM=1 to enable.
#
# Also adds: Improvement B (router threshold env vars).
FROM turboocr:pool AS builder

USER root

# Headers that changed vs pool image.
COPY include/turbo_ocr/pipeline/pipeline_result.h  /app/include/turbo_ocr/pipeline/pipeline_result.h
COPY include/turbo_ocr/pipeline/ocr_pipeline.h     /app/include/turbo_ocr/pipeline/ocr_pipeline.h
COPY include/turbo_ocr/router/router_types.h        /app/include/turbo_ocr/router/router_types.h
COPY include/turbo_ocr/formula/vlm_formula.h        /app/include/turbo_ocr/formula/vlm_formula.h
COPY include/turbo_ocr/formula/vlm_text_rerec.h     /app/include/turbo_ocr/formula/vlm_text_rerec.h
COPY include/turbo_ocr/table/vlm_table.h            /app/include/turbo_ocr/table/vlm_table.h
# Headers synced from pool image (were divergent in local checkout).
COPY include/turbo_ocr/pipeline/pipeline_dispatcher.h  /app/include/turbo_ocr/pipeline/pipeline_dispatcher.h
COPY include/turbo_ocr/server/server_config.h          /app/include/turbo_ocr/server/server_config.h
COPY include/turbo_ocr/server/server_types.h           /app/include/turbo_ocr/server/server_types.h
COPY include/turbo_ocr/table/html_reconstruct.h        /app/include/turbo_ocr/table/html_reconstruct.h
COPY include/turbo_ocr/table/cell_matcher.h            /app/include/turbo_ocr/table/cell_matcher.h
COPY include/turbo_ocr/table/slanext_postprocess.h     /app/include/turbo_ocr/table/slanext_postprocess.h
COPY include/turbo_ocr/formula/formula_kernels.h       /app/include/turbo_ocr/formula/formula_kernels.h
COPY include/turbo_ocr/formula/formulanet.h            /app/include/turbo_ocr/formula/formulanet.h
# New vlm headers (not in pool image at all).
COPY include/turbo_ocr/vlm/crop_pool.h  /app/include/turbo_ocr/vlm/crop_pool.h

# Source files that changed vs pool image (our Improvement A/B additions).
COPY src/formula/vlm_formula.cpp      /app/src/formula/vlm_formula.cpp
COPY src/formula/vlm_text_rerec.cpp   /app/src/formula/vlm_text_rerec.cpp
COPY src/table/vlm_table.cpp          /app/src/table/vlm_table.cpp
COPY src/pipeline/ocr_pipeline.cpp    /app/src/pipeline/ocr_pipeline.cpp
COPY src/routes/image_routes.cpp      /app/src/routes/image_routes.cpp
COPY src/routes/pdf_routes.cpp        /app/src/routes/pdf_routes.cpp
COPY src/router/cua_router.cpp        /app/src/router/cua_router.cpp
# Source files synced from pool image (were divergent in local checkout).
COPY src/formula/formula_recognizer.cpp    /app/src/formula/formula_recognizer.cpp
COPY src/formula/formulanet.cpp            /app/src/formula/formulanet.cpp
COPY src/formula/kernels/formula_kernels.cu /app/src/formula/kernels/formula_kernels.cu
COPY src/table/html_reconstruct.cpp        /app/src/table/html_reconstruct.cpp
COPY src/table/cell_matcher.cpp            /app/src/table/cell_matcher.cpp
COPY src/table/slanext_dict.cpp            /app/src/table/slanext_dict.cpp
COPY src/table/slanext_postprocess.cpp     /app/src/table/slanext_postprocess.cpp
COPY src/server/main.cpp                   /app/src/server/main.cpp
# New vlm source (not in pool image at all).
COPY src/vlm/CMakeLists.txt   /app/src/vlm/CMakeLists.txt
COPY src/vlm/crop_pool.cpp    /app/src/vlm/crop_pool.cpp
# CMakeLists.txt updated to add src/vlm subdirectory.
COPY src/formula/CMakeLists.txt  /app/src/formula/CMakeLists.txt
COPY src/table/CMakeLists.txt    /app/src/table/CMakeLists.txt
COPY CMakeLists.txt              /app/CMakeLists.txt

# Docker overlay2 makes lower-layer root-owned files immutable.
# The cmake LTO test directory from the pool build can't be overwritten.
# Solution: copy /app/build to a writable /tmp/build, delete the stale
# LTO test dir and CMakeCache (so cmake re-configures cleanly), copy the
# existing .o files so incremental compilation skips unchanged files, then
# copy the resulting binary back.
RUN cp -a /app/build/. /tmp/build && \
    rm -rf /tmp/build/CMakeFiles/_CMakeLTOTest-CXX && \
    rm -f /tmp/build/CMakeCache.txt

# Rebuild turboocr-server from the writable build directory.
RUN cd /tmp/build && \
    cmake /app \
        -DTENSORRT_DIR=/usr/lib/x86_64-linux-gnu \
        -DFETCH_MODELS=OFF \
        -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) turboocr-server 2>&1 && \
    cp turboocr-server /app/build/turboocr-server

RUN chown -R ocr:ocr /app/build

FROM turboocr:pool
USER root
COPY --from=builder /app/build/turboocr-server /app/build/turboocr-server
RUN chown ocr:ocr /app/build/turboocr-server

ENTRYPOINT ["/app/scripts/entrypoint.sh"]
CMD ["./build/turboocr-server"]
