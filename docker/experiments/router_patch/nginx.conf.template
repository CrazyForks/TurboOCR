daemon on;
pid /tmp/nginx.pid;
worker_processes auto;
worker_rlimit_nofile 65535;
error_log /dev/stderr error;

events {
    worker_connections 4096;
    multi_accept on;
}

http {
    access_log off;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    default_type application/json;

    # proxy_request_buffering on (below) spools the request body to disk past
    # the in-memory buffer; keep that scratch under /tmp like pid, so it works
    # on a read-only rootfs and without the package's /var/lib/nginx dir.
    client_body_temp_path /tmp/nginx-client-body;

    upstream ocr_backend {
        server 127.0.0.1:8083;
        keepalive 128;
    }

    server {
        listen 8082 backlog=4096 reuseport;

        client_max_body_size ${MAX_BODY_MB}m;
        proxy_connect_timeout 120s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_next_upstream off;

        # Bodies are hard-capped at MAX_BODY_MB, so buffer the full request
        # before opening an upstream connection: shields the backend from
        # slow-trickle uploads holding a worker, and lets the
        # client_body_timeout below reap stalled senders at the edge.
        proxy_request_buffering on;

        # Slow-loris mitigation: reap clients that open a connection and then
        # trickle (or never send) the request header/body or stall reading the
        # response, instead of pinning an nginx worker for proxy_*_timeout.
        client_header_timeout 30s;
        client_body_timeout 30s;
        send_timeout 30s;

        error_page 413 =413 @error_413;
        error_page 502 =503 @error_upstream_down;
        error_page 504 =504 @error_504;

        location @error_413 {
            return 413 '{"error":"Request body too large (max ${MAX_BODY_MB}MB)"}';
        }
        location @error_upstream_down {
            add_header Retry-After 15 always;
            return 503 '{"error":"Backend not ready"}';
        }
        location @error_504 {
            return 504 '{"error":"Backend timeout"}';
        }

        # /metrics leaks VRAM/topology — keep it off the public proxy.
        # Reachable only from loopback and the operator-supplied CIDR
        # (METRICS_ALLOW_CIDR, defaults to the RFC1918 pod range); everyone
        # else gets 403. Listed before location / so it wins the match.
        location = /metrics {
            allow 127.0.0.1;
            allow ${METRICS_ALLOW_CIDR};
            deny all;

            proxy_pass http://ocr_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header X-Request-Id $http_x_request_id;
        }

        location / {
            proxy_pass http://ocr_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header X-Request-Id $http_x_request_id;
        }
    }
}
