*.log
*.trt
LICENSE
README.md
.clang-format
tests/benchmark/
tests/integration/
tests/regression/
tests/fixtures/

# Local artifacts never COPYed by docker/Dockerfile.{gpu,cpu} (models are fetched
# at build time, not copied). Excluding them keeps the build context lean.
models.bak/
.trt_cache/
