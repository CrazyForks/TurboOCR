daemon on;
pid /tmp/nginx.pid;
worker_processes auto;
worker_rlimit_nofile 65535;
error_log /dev/stderr error;

events {
    worker_connections 4096;
    multi_accept on;
}

http {
    access_log off;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    default_type application/json;

    upstream ocr_backend {
        server 127.0.0.1:8083;
        keepalive 128;
    }

    server {
        listen 8082 backlog=4096 reuseport;

        client_max_body_size ${MAX_BODY_MB}m;
        proxy_connect_timeout 120s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_next_upstream off;

        error_page 413 =413 @error_413;
        error_page 502 =503 @error_upstream_down;
        error_page 504 =504 @error_504;

        location @error_413 {
            return 413 '{"error":"Request body too large (max ${MAX_BODY_MB}MB)"}';
        }
        location @error_upstream_down {
            add_header Retry-After 15 always;
            return 503 '{"error":"Backend not ready"}';
        }
        location @error_504 {
            return 504 '{"error":"Backend timeout"}';
        }

        location / {
            proxy_pass http://ocr_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header X-Request-Id $http_x_request_id;
        }
    }
}
