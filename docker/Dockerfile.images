FROM turboocr:images

USER root
RUN apt-get update && apt-get install -y --no-install-recommends libturbojpeg0-dev \
    && rm -rf /var/lib/apt/lists/*

RUN rm -f /app/include/turbo_ocr/common/sha256.h \
          /app/include/turbo_ocr/pdf/page_image_cache.h \
          /app/src/pdf/page_image_cache.cpp

COPY CMakeLists.txt /app/CMakeLists.txt
COPY include/turbo_ocr/pdf/page_image_encoder.h /app/include/turbo_ocr/pdf/page_image_encoder.h
COPY include/turbo_ocr/routes/pdf_routes.h      /app/include/turbo_ocr/routes/pdf_routes.h
COPY src/pdf/page_image_encoder.cpp             /app/src/pdf/page_image_encoder.cpp
COPY src/routes/pdf_routes.cpp                  /app/src/routes/pdf_routes.cpp
COPY src/server/main.cpp                        /app/src/server/main.cpp
COPY src/server/cpu_main.cpp                    /app/src/server/cpu_main.cpp

RUN rm -rf /app/build && mkdir -p /app/build && cd /app/build \
    && cmake -DCMAKE_BUILD_TYPE=Release -DTENSORRT_DIR=/usr/lib/x86_64-linux-gnu -DFETCH_MODELS=OFF .. \
    && make -j$(nproc) \
    && chown -R ocr:ocr /app/build
